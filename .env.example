# IMPORTANTE: copie este arquivo para ".env" na raiz do projeto.
# O Vite NÃO carrega .env.example — só .env ou .env.local
#
# No Windows: copy .env.example .env
# Ou use iniciar-site.bat (cria .env automaticamente se faltar)

# ─── Filial RP (Capital MT BR) ───
VITE_DISCORD_INVITE=https://discord.gg/nDz7grbuvB
VITE_DISCORD_SERVER_ID=1489492393819504692

# ─── Filial EB (Exército Brasileiro) ───
VITE_EB_DISCORD_INVITE=https://discord.gg/3A4szCrrpw
VITE_EB_DISCORD_SERVER_ID=1426225171689111594

# Link Roblox do EB está fixo em src/config/community.ts (não precisa de variável aqui).

# Opcional: número fixo se o widget do Discord estiver desativado no servidor
# VITE_DEMO_ONLINE_PLAYERS=0
# VITE_EB_DEMO_ONLINE_PLAYERS=0

# NÃO use URL https://discord.com/... em PLAYERS_API (causa erro de CORS no navegador)

# ─── Discord OAuth2 (servidor — NÃO use prefixo VITE_) ───
DISCORD_CLIENT_ID=seu_client_id
DISCORD_CLIENT_SECRET=seu_client_secret
SESSION_SECRET=gere_um_valor_aleatorio_longo
# Dev: URL do Vite. Redirect no Discord Developer Portal:
#   http://localhost:5173/auth/callback
BASE_URL=http://localhost:5173
# Produção (Discloud): https://reueleberp.discloud.app

# ─── Bot: entrar nos servidores ao logar (guilds.join) ───
# 1) Mesma aplicação OAuth → Bot → Reset Token → cole abaixo
# 2) Convide o bot para RP e EB (permissão "Criar convite" no mínimo)
# 3) Deixe DISCORD_AUTO_JOIN_ENABLED=1 (ou omita)
DISCORD_BOT_TOKEN=
# Opcional: lista fixa (senão usa VITE_DISCORD_SERVER_ID + VITE_EB_DISCORD_SERVER_ID)
# DISCORD_AUTO_JOIN_GUILD_IDS=1489492393819504692,1426225171689111594
# DISCORD_AUTO_JOIN_ENABLED=0

# Painel admin: IDs Discord com acesso forçado (opcional, separados por vírgula)
# DISCORD_ADMIN_USER_IDS=123456789012345678

# ─── Discloud: edite ID= no discloud.config com seu subdomínio ───
